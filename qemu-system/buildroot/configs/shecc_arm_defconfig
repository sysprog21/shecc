# ARMv7-A guest. The userland is the Debian armhf baseline (Thumb-2, VFPv3-D16,
# hard-float EABI) that shecc's DYN_LINKER and ELF_FLAGS name.
BR2_arm=y
BR2_cortex_a15=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV3D16=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Shared by the three defconfigs. The test scripts get the GNU tools host CI
# runs them with, and a merged /usr leaves no second bin directory where a
# BusyBox applet could shadow one; post-build.sh checks both.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_REPRODUCIBLE=y
BR2_ROOTFS_MERGED_USR=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="arm"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_STRACE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set

# multi_v7_defconfig, which already has what the guest needs.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_ZIMAGE=y
