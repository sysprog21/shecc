# AArch64 guest with 64 KiB pages; Buildroot sets the kernel's page size from
# BR2_ARM64_PAGE_SIZE_64K.
BR2_aarch64=y
BR2_ARM64_PAGE_SIZE_64K=y

# Shared by the three defconfigs; see shecc_arm_defconfig.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_REPRODUCIBLE=y
BR2_ROOTFS_MERGED_USR=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="arm64"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_STRACE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set

# The kernel's own defconfig, which already has what the guest needs.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_IMAGEGZ=y
