# RV32 guest, with glibc built for the ilp32d ABI that shecc's ELF_FLAGS and
# DYN_LINKER name.
BR2_riscv=y
BR2_RISCV_32=y
BR2_RISCV_ABI_ILP32D=y

# Shared by the three defconfigs; see shecc_arm_defconfig. Buildroot builds no
# strace for RV32.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_REPRODUCIBLE=y
BR2_ROOTFS_MERGED_USR=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SHECC_PATH)/board/shecc/common/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="riscv"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set

# The kernel's rv32_defconfig target, its defconfig with 32-bit.config merged
# in; the architecture default would be a 64-bit kernel. QEMU loads no
# compressed RISC-V kernel, so qemu-system/run.sh decompresses this one.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="rv32"
BR2_LINUX_KERNEL_IMAGEGZ=y
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_PLAT="generic"
