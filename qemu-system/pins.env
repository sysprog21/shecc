# What qemu-system/build-images.sh takes from outside this repository.

# The newest release of Buildroot's 2025.02 long-term branch, and the SHA256
# line of its buildroot-2025.02.18.tar.xz.sign.
BR_VERSION=2025.02.18
BR_SHA256=e38ad1df6ea0479fff6419a87a64535d02131674d463be154a763ef725b55321

# registry.gitlab.com/buildroot.org/buildroot/base:20250218.2110, the image
# Buildroot's own CI uses for this release, pinned by its multi-platform index.
# The images come from its arm64 variant, which runs natively on Apple Silicon
# and on GitHub's Arm64 runners.
BR_IMAGE=registry.gitlab.com/buildroot.org/buildroot/base@sha256:340aa0de68e8e13e4eca70a00aaf94ec68d3a3891c28f3e7495d844829a8c958
BR_PLATFORM=linux/arm64

# Buildroot's own release date, which it would also use outside a git tree.
SOURCE_DATE_EPOCH=1789067700
